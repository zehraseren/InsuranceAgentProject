@model BDPagingViewModel

<div class="posts_navigation pt-35 pb-35">
    <div class="row align-items-center">
        <div class="col-xl-4 col-md-5">
            <div>
                <span>Önceki Gönderi</span>
                <h4><a href="/Blog/BlogDetail/@Model.PreviousId">@Model.PreviousTitle</a></h4>
            </div>
        </div>
        <div class="col-xl-4 col-md-2 text-center">
            <span style="display:inline-flex;justify-content:center;align-items:center;">
                <img src="/defaultimages/blog/insurance-shield.png" alt="Sigorta" style="width:90px;height:90px;border-radius:50%;background-color:#e6f3ff;padding:15px;">
            </span>
        </div>
        <div class="col-xl-4 col-md-5">
            <div class="text-left text-md-right">
                <span>Sonraki Gönderi</span>
                <h4><a href="/Blog/BlogDetail/@Model.NextId">@Model.NextTitle</a></h4>
            </div>
        </div>
    </div>
</div>