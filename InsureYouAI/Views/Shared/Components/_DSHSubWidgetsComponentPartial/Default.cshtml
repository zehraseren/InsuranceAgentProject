@model DSHSubWidgetsViewModel

<div class="row row-cols-1 row-cols-lg-4 row-cols-xl-4">
    <div class="col">
        <div class="card rounded-4 bg-purple">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="">
                        <h4 class="mb-0 text-white">@Model.TotalCategoryCount</h4>
                        <p class="mb-1 text-white">Toplam Kategori</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card rounded-4 bg-primary">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="">
                        <h4 class="mb-0 text-white">@Model.TotalArticleCount</h4>
                        <p class="mb-1 text-white">Toplam Makale</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card rounded-4 bg-orange">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="">
                        <h4 class="mb-0 text-white">@Model.TotalPoliciesCount</h4>
                        <p class="mb-1 text-white">Satılan Poliçe Sayısı</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card rounded-4 bg-success">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="">
                        <h4 class="mb-0 text-white">@Model.TotalPoliciesByThisMonthCount</h4>
                        <p class="mb-1 text-white">Bu Ay Satılan Poliçe Sayısı</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row row-cols-1 row-cols-lg-4 row-cols-xl-4">
    <div class="col">
        <div class="card rounded-4 bg-pink">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="">
                        <h4 class="mb-0 text-white">@Model.TotalCommentCount</h4>
                        <p class="mb-1 text-white">Toplam Yorum Sayısı</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card rounded-4 bg-warning">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="">
                        <h4 class="mb-0 text-white">@Model.TotalUserCount</h4>
                        <p class="mb-1 text-white">Toplam Kullanıcı Sayısı</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card rounded-4 bg-dark">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="">
                        <h4 class="mb-0 text-white">@Model.AvgPolicyAmount.ToString("C")</h4>
                        <p class="mb-1 text-white">Ortalama Poliçe Tutarı / ₺</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card rounded-4 bg-bronze">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="">
                        <h4 class="mb-0 text-white">@Model.LastRevenueAmount.ToString("C")</h4>
                        <p class="mb-1 text-white">Son Yapılan Poliçe Tutarı</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>