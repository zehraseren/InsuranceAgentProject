@using System.Globalization
@model List<DSHUserQuickViewModel>

<style>
    .user-list-modern {
        max-height: 420px;
        overflow-y: auto;
        padding-right: 6px;
    }

        .user-list-modern::-webkit-scrollbar {
            width: 6px;
        }

        .user-list-modern::-webkit-scrollbar-thumb {
            background: #ccc;
            border-radius: 4px;
        }

    .user-card {
        transition: all 0.25s ease;
    }

        .user-card:hover {
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
            transform: translateY(-3px);
        }

        .user-card .avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
        }

        .user-card .stats {
            font-size: 13px;
            color: #6c757d;
        }
</style>

<div class="col-12 col-lg-6 col-xl-6 d-flex">
    <div class="card rounded-4 w-100">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <h6 class="mb-0">En Popüler Kullanıcılar ve Müşteriler</h6>
            </div>
            <div class="user-list-modern">
                @foreach (var item in Model)
                {
                    <div class="user-card d-flex justify-content-between align-items-center p-3 mb-3 rounded-3 border bg-white">
                        <div class="d-flex align-items-center gap-3">
                            <img src="@item.ImageUrl" class="avatar" alt="@item.FullName" />
                            <div>
                                <h6 class="mb-1">@item.FullName</h6>
                                <div class="stats d-flex gap-3">
                                    <span><i class="bi bi-shield-check"></i> @item.PolicyCount poliçe</span>
                                    <span><i class="bi bi-wallet2"></i> @item.TotalPremium.ToString("N2", CultureInfo.InvariantCulture) ₺</span>
                                </div>
                            </div>
                        </div>
                        <a href="#" class="btn btn-warning btn-sm rounded-pill">Detaylar</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>