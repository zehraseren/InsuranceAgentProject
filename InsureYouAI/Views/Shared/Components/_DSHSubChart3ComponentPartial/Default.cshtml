@using Newtonsoft.Json
@model List<DSHMonthlyExpenseViewModel>

<div class="col">
    <div class="card rounded-4">
        <div class="card-body d-flex flex-column" style="height: 280px;">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="">
                    <h4 class="mb-0">Aylık Giderler</h4>
                    <p class="mb-0">Son 1 Ay (₺)</p>
                </div>
                <div class="fs-2 text-danger">
                    <i class="bi bi-pie-chart-fill"></i>
                </div>
            </div>
            <div style="position: relative; height: 180px;">
                <canvas id="monthlyExpensesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    const ctxExpenses = document.getElementById('monthlyExpensesChart').getContext('2d');

    const monthlyExpensesChart = new Chart(ctxExpenses, {
        type: 'pie',
        data: {
            labels: @Html.Raw(JsonConvert.SerializeObject(Model.Select(m => m.CategoryName))),
            datasets: [{
                label: 'Giderler',
                data: @Html.Raw(JsonConvert.SerializeObject(Model.Select(m => m.TotalAmount))),
                backgroundColor: [
                    'rgba(255, 99, 132, 0.7)',
                    'rgba(54, 162, 235, 0.7)',
                    'rgba(255, 206, 86, 0.7)',
                    'rgba(75, 192, 192, 0.7)',
                    'rgba(153, 102, 255, 0.7)',
                    'rgba(255, 159, 64, 0.7)'
                ],
                borderColor: [
                    'rgba(255, 99, 132, 1)',
                    'rgba(54, 162, 235, 1)',
                    'rgba(255, 206, 86, 1)',
                    'rgba(75, 192, 192, 1)',
                    'rgba(153, 102, 255, 1)',
                    'rgba(255, 159, 64, 1)'
                ],
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return context.label + ': ' + context.raw.toLocaleString('tr-TR') + " ₺";
                        }
                    }
                }
            }
        }
    });

</script>